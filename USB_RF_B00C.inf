[Version]
CatalogFile                      = hiddev.cat
LayoutFile                       = Layout.inf, Layout1.inf, Layout2.inf
Signature                        = "$CHICAGO$"
Class                            = HID
ClassGUID                        = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider                         = "Padix, Taiwan, R.O.C."
SetupClass                       = Base

[BaseWinOptions]
Inst_Hiddev

[Inst_Hiddev]
Copyfiles                        = Hid.Inf.Copy

[Hid.Inf.Copy]
;joystick.inf

[DestinationDirs]
DefaultDestDir                   = 11             ; LDID_SYS, the Windows\System directory
HidClassCopy                     = 11
HidClassDel                      = 25
Hid.Inf.Copy                     = 17             ; LDID_INF, the Windows\Inf directory
USBHIDDevice.Copy                = 10,system32\drivers
USBHIDDevice.Del                 = 11
HIDSystemControl.Copy            = 11
MMHID.Copy                       = 11
MMHID.Del                        = 25

[ClassInstall]
AddReg                           = HIDClassReg
CopyFiles                        = HidClassCopy
DelFiles                         = HidClassDel

[HIDClassReg]
HKR,,,0,%HIDClassDescription%
HKR,,Icon,,-24
HKR,,Installer,,hidci.dll  ; the class installer forces RunOnce entries
                           ; to be executed for all hid device installs

[HidClassCopy]
hidci.dll

[HidClassDel]
hidci.dll

[Manufacturer]
%Rockfire.Mfg%                   = Rockfire.Section

[Rockfire.Section]

%USB\VID_0583&PID_B00C.DeviceDesc%=B00C.Section,USB\VID_0583&PID_B00C&REV_0120
%USB\VID_0583&PID_B00C.DeviceDesc%=B00C.Section,USB\VID_0583&PID_B00C&REV_0100
%USB\VID_0583&PID_B00C.DeviceDesc%=B00C.Section,USB\VID_0583&PID_B00C

[B00C.Section]
CopyFiles=Hid.Inf.Copy,USBHIDDevice.Copy
DelFiles=USBHIDDevice.Del
AddReg=B00C.AddReg
KnownFiles=USBHIDDevice.KnownFiles

[USBHIDDevice.Copy]
hidclass.sys
hidusb.sys
hidparse.sys

[USBHIDDevice.Del]
hidclass.sys
hidusb.sys
hidparse.sys

[USBHIDDevice.KnownFiles]
hidclass.sys
hidusb.sys
hidparse.sys

[B00C.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,DriverDesc,,%USB\VID_0583&PID_B00C.DeviceDesc%
HKR,,MatchingDeviceId,,USB\VID_0583&PID_B00C&REV_0100,USB\VID_0583&PID_B00C
HKR,,NTMPDriver,,"hidusb.sys"


