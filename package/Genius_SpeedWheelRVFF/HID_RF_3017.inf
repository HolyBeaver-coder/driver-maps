[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%Rockfire.Mfg%=RockFire,NT,NTamd64

[RockFire.NT]
%HID\VID_0458&PID_3017.DeviceDesc%=3017.NT,HID\VID_0458&PID_3017

[RockFire.NTamd64]
%HID\VID_0458&PID_3017.DeviceDesc%=3017.NTamd64,HID\VID_0458&PID_3017

[DestinationDirs]
Driver_copyfiles = 11
Dyncal_copyfiles = 12
Dyncal64_copyfiles = 12

[SourceDisksNames]
1 = %Disk_Desc%,,,

[SourceDisksFiles]
dyncal64.sys=1
rfvibra64.dll=1
rfvibra264.dll=1
rfcplsvr64.dll=1

[Dyncal64_copyfiles]
dyncal64.sys

[Driver64_copyfiles]
rfvibra64.dll
rfvibra264.dll
rfcplsvr64.dll

[3017.NT]
CopyFiles = Driver64_copyfiles,Dyncal64_copyfiles
AddReg=3017.AddReg,CPLadd64.reg,RFVibra164.reg,RFVibra264.reg

[3017.NT.HW]
;AddReg=Dyncal_addreg
AddReg=3017.NT.HW.AddReg

[3017.NT.Services]
;AddService = dyncal,%Dyncal_ASSOCSERVICE%,Dyncal_service
;AddService = dyncal,,Dyncal_service
;AddService = dyncal,0x00000800,Dyncal_service
AddService = dyncal,0x00000002,Dyncal_service

[Dyncal_service]
DisplayName   = %Dyncal_ServiceDesc%
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START
ErrorControl  = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\dyncal64.sys

[3017.NT.HW.AddReg]
;HKR,,"UpperFilters",0x00010008,"Dyncal"
HKR,,"Service",,"Dyncal"  

[3017.NTamd64]
CopyFiles = Driver64_copyfiles,Dyncal64_copyfiles
AddReg=3017.AddReg,CPLadd64.reg,RFVibra164.reg,RFVibra264.reg

[3017.NTamd64.Services]
;AddService = dyncal64,%Dyncal_ASSOCSERVICE%,Dyncal64_service
;AddService = dyncal64,,Dyncal64_service
;AddService = dyncal64,0x00000001,Dyncal64_service
AddService = dyncal64,0x00000002,Dyncal64_service

[Dyncal64_service]
DisplayName   = %Dyncal64_ServiceDesc%
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START
ErrorControl  = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\dyncal64.sys

[3017.NTamd64.HW]
;AddReg=Dyncal64_addreg
AddReg=3017.NTamd64.HW.AddReg

[3017.NTamd64.HW.AddReg]
;HKR,,"UpperFilters",0x00010008,"Dyncal64"  
HKR,,"Service",,"Dyncal64"  

